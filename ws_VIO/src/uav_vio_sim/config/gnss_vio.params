# PX4 50dabd8: applied by rcS before EKF2 starts, never switched in flight.
EKF2_GPS_MODE 1
EKF2_GPS_CTRL 7
# No EV horizontal position: this PX4 resets to the arbitrary EV origin on
# GNSS loss when bit 0 is enabled (ev_pos_control.cpp). Fuse height + 3D velocity.
EKF2_EV_CTRL 6
EKF2_HGT_REF 0
EKF2_BARO_CTRL 1
EKF2_EV_NOISE_MD 0
EKF2_EV_QMIN 1
EKF2_EV_DELAY 0
# The adapter already moves the measurement to base_link.
EKF2_EV_POS_X 0
EKF2_EV_POS_Y 0
EKF2_EV_POS_Z 0
SYS_HAS_GPS 1
SIM_GZ_EN_GPS 1
# Restore a healthy SITL starting condition after native GNSS failure tests.
SIM_GPS_USED 10
# Gazebo supplies GNSS; no second GPS simulator.
SENS_EN_GPSSIM 0
# SITL only: PX4 HRT and ROS /clock both use Gazebo time, not Agent OS time.
UXRCE_DDS_SYNCT 0
# Finite PX4 position-loss checks and the stock no-aid timeout.
COM_POS_FS_EPH 5
EKF2_NOAID_TOUT 5000000
