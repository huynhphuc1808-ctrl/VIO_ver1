  <version>0.1.0</version>
  <description>Gazebo Harmonic and PX4 SITL assets for the ws_VIO x500 D435i simulation.</description>
  <maintainer email="huynhphuc1808@gmail.com">phuc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
