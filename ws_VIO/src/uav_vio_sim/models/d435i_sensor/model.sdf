<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="d435i_sensor">
    <link name="d435_link">
      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>5.235e-05</ixx>
          <iyy>7.500e-06</iyy>
          <izz>5.235e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="d435_body_collision">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
      </collision>

      <visual name="d435_body_visual">
        <geometry>
          <box>
            <size>0.025 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.06 0.06 0.06 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <visual name="left_imager_visual">
        <pose>0.013 0.025 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.003</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <visual name="right_imager_visual">
        <pose>0.013 -0.025 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.003</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <visual name="rgb_imager_visual">
        <pose>0.013 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.003</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.18 1</ambient>
          <diffuse>0.10 0.15 0.30 1</diffuse>
        </material>
      </visual>

      <sensor name="d435_left" type="camera">
        <pose>0 0.025 0 0 0 0</pose>
        <gz_frame_id>d435_left_optical_frame</gz_frame_id>
        <topic>/vio/sensors/d435/left/image_raw</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.4870205</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="d435_right" type="camera">
        <pose>0 -0.025 0 0 0 0</pose>
        <gz_frame_id>d435_right_optical_frame</gz_frame_id>
        <topic>/vio/sensors/d435/right/image_raw</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.4870205</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- Visualization-only cameras wake when their lazy bridge has consumers. -->
      <sensor name="d435_color" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>d435_color_optical_frame</gz_frame_id>
        <topic>/vio/sensors/d435/image_raw</topic>
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.2112585</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="d435_depth" type="depth_camera">
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>d435_depth_optical_frame</gz_frame_id>
        <topic>/vio/sensors/d435/depth/image_raw</topic>
        <topic>/vio/sensors/d435/depth/points</topic>
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.4870205</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <min_depth>0.10</min_depth>
              <max_depth>10.0</max_depth>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name="d435_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>d435_imu_frame</gz_frame_id>
        <topic>/vio/sensors/d435/imu</topic>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
  </model>
</sdf>
