# Copy to docker/.env; run commands from the repository root.
VIO_UID=1000
VIO_GID=1000
VIO_BUILD_JOBS=2
INSTALL_REALSENSE=false
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=1
GZ_PARTITION=uav_vio
GZ_IP=127.0.0.1
MICRO_XRCE_PORT=8888
# Required by compose.yaml. Use real absolute paths; preserve symlink targets.
# PX4_WS=/path/to/ws_px4
# VIO_ALGORITHM_WS=/path/to/ws_vio_references
# Needed with compose.external.yaml and full compatibility validation.
# PX4_DIR=/path/to/PX4-Autopilot
# Only needed with compose.gui.yaml.
# DOCKER_XAUTHORITY=/path/to/vio.xauth
